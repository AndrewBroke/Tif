        {
          "key":  "act2.cannot_leave.node_0.text",
          "ru":  "Я не могу уйти из Новониколаевска. У меня тут жена, ребенок, работа, жизнь.",
          "en":  "I can't leave Novonikolayevsk. My wife, my child, my work, my life are all here."
        },
        {
          "key":  "act2.cannot_leave.node_0.name",
          "ru":  "Герой",
          "en":  "Protagonist"
        },
        {
          "key":  "act2.cannot_leave.node_1.text",
          "ru":  "Закрыть",
          "en":  "Close"
        }
      ]
    },
    {
      "asset":  "Assets/Scenes/Act 2 Main.unity",
      "localId":  "1253587267",
      "id":  "act2.hand_over_log",
