        }
      ]
    },
    {
      "asset":  "Assets/Scenes/Act 2 Main.unity",
      "localId":  "743591164",
      "id":  "act2.orderly_conversation",
      "entries":  [
        {
          "key":  "act2.orderly_conversation.node_0.text",
          "ru":  "Добрый вечер",
          "en":  "Good evening."
        },
        {
          "key":  "act2.orderly_conversation.node_0.name",
          "ru":  "Санитар",
          "en":  "Orderly"
        },
        {
          "key":  "act2.orderly_conversation.node_2.text",
          "ru":  "Простите, я тороплюсь",
          "en":  "I'm sorry, I'm in a hurry."
        },
        {
          "key":  "act2.orderly_conversation.node_2.name",
          "ru":  "Санитар",
          "en":  "Orderly"
        },
        {
          "key":  "act2.orderly_conversation.node_5.text",
          "ru":  "Что мой дом?",
          "en":  "What about my house?"
        },
        {
          "key":  "act2.orderly_conversation.node_5.name",
          "ru":  "Санитар",
          "en":  "Orderly"
        },
        {
          "key":  "act2.orderly_conversation.node_7.text",
          "ru":  "Ну... Должны... Но я получил бумагу.",
          "en":  "Well... They were going to... But I got a document."
        },
        {
          "key":  "act2.orderly_conversation.node_7.name",
          "ru":  "Санитар",
          "en":  "Orderly"
        },
        {
          "key":  "act2.orderly_conversation.node_9.text",
          "ru":  "Что вы ко мне пристали, я тороплюсь, до свидания.",
          "en":  "Why won't you leave me alone? I'm in a hurry. Goodbye."
        },
        {
          "key":  "act2.orderly_conversation.node_9.name",
          "ru":  "Санитар",
          "en":  "Orderly"
        },
        {
          "key":  "act2.orderly_conversation.node_1.text",
          "ru":  "Добрый",
          "en":  "Evening."
        },
        {
          "key":  "act2.orderly_conversation.node_3.text",
          "ru":  "Уйти",
          "en":  "Leave"
        },
        {
          "key":  "act2.orderly_conversation.node_4.text",
          "ru":  "Ваш дом...",
          "en":  "Your house..."
        },
        {
          "key":  "act2.orderly_conversation.node_6.text",
          "ru":  "Его заселяют?",
          "en":  "Are they moving people in?"
        },
        {
          "key":  "act2.orderly_conversation.node_8.text",
          "ru":  "Какую бумагу?",
          "en":  "What document?"
        }
      ]
    },
