  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_Act2_ru
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ru
  m_SharedData: {fileID: 11400000, guid: c87e7bff18f0c8b4ea7bab914586b77c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1169154048
    m_Localized: "\u0412\u043E\u0448\u044C. \u0421\u043C\u0435\u0440\u0442\u044C.
      \u0417\u0430\u0440\u0430\u0437\u0430. \u0411\u0443\u0434\u0442\u043E \u0432\u043E\u043A\u0440\u0443\u0433
      \u043C\u0430\u043B\u043E \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097088
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097089
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097090
    m_Localized: "\u0422\u0443\u0442 \u044F \u0443\u0436\u0435 \u043D\u0435 \u043F\u0440\u043E\u0439\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097091
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097092
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097093
    m_Localized: "\u042D\u0442\u043E \u043D\u0435 \u0441\u0430\u043C\u044B\u0439
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097094
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097095
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097096
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C \u043D\u043E\u0432\u044B\u0439
      \u043B\u0438\u0441\u0442. \u0410 \u043C\u0451\u0440\u0442\u0432\u044B\u0445
      \u043C\u0435\u043D\u044C\u0448\u0435 \u043D\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097097
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097098
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097099
    m_Localized: "\u0412\u043E\u0435\u043D\u043D\u044B\u0439 \u0433\u043E\u0440\u043E\u0434\u043E\u043A,
      \u0432\u0445\u043E\u0434 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E
      \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097100
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097101
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097102
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u0438\u0446\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097103
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097104
    m_Localized: "\u0414\u0430, \u044D\u0442\u043E \u0431\u044B\u043B\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F
      \u0432\u044B\u0434\u0430\u0447\u0430 \u043D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F.
      \u0427\u0442\u043E \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097105
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097106
    m_Localized: "\u042F \u0436\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0430,
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0432\u044B\u0434\u0430\u0447\u0430,
      \u0434\u0440\u043E\u0432\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C.
      \u0412\u0441\u0451, \u0434\u043E \u0441\u0432\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097107
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097108
    m_Localized: "\u0427\u0442\u043E \u0435\u0449\u0435, \u044F \u0436\u0435 \u0432\u0441\u0451
      \u0443\u0436\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097109
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097110
    m_Localized: "\u041D\u0443 \u043F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E,
      \u0431\u0443\u0434\u0443\u0442 \u043D\u043E\u0432\u044B\u0435 \u0441\u043E\u0441\u0435\u0434\u0438,
      \u043F\u043E\u044E\u0442\u0438\u0442\u0435\u0441\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097111
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097112
    m_Localized: "\u041A\u0430\u043A \u0436\u0435\u043D\u0430, \u043A\u0430\u043A
      \u0440\u0435\u0431\u0435\u043D\u043E\u043A? \u0422\u0430\u043A\u0438\u0435
      \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u044B \u0437\u0430\u0441\u0435\u043B\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097113
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097114
    m_Localized: "\u0410, \u043D\u0443 \u0442\u043E\u0433\u0434\u0430 \u043F\u043E\u043D\u044F\u0442\u043D\u043E.
      \u0412\u044B \u0447\u0442\u043E \u043E\u0442 \u043C\u0435\u043D\u044F \u0445\u043E\u0442\u0438\u0442\u0435?
      \u0427\u0442\u043E\u0431\u044B \u044F \u0432\u0430\u0448\u0443 \u0436\u0435\u043D\u0443
      \u0438 \u0440\u0435\u0431\u0435\u043D\u043A\u0430 \u0437\u0430\u043F\u0438\u0441\u0430\u043B\u0430
      \u0432 \u0434\u043E\u043C? \u0422\u0430\u043A \u044F \u043D\u0435 \u043C\u043E\u0433\u0443
      \u0442\u0430\u043A\u043E\u0433\u043E, \u0432\u0430\u043C \u043A \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0430\u043C
      \u043D\u0430\u0434\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097115
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097116
    m_Localized: "\u0415\u0441\u0442\u044C \u0442\u0430\u043A\u0438\u0435, \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0430\u043C,
      \u043C\u0435\u0434 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0443 \u0432\u044B\u0434\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097117
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097118
    m_Localized: "\u042D\u0442\u043E \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u0435\u0440\u0442\u0432\u044B\u0445
      \u0432\u043E\u0437\u044F\u0442? \u041D\u0435\u043B\u0435\u0433\u043A\u043E,
      \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097119
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097120
    m_Localized: "\u042F \u0431\u044B \u0445\u043E\u0442\u0435\u043B\u0430 \u043F\u043E\u043C\u043E\u0447\u044C,
      \u043D\u043E \u0431\u0443\u043C\u0430\u0433\u0438 \u0442\u0430\u043A\u043E\u0439
      \u0432\u044B\u0434\u0430\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435
      \u043C\u043E\u0433\u0443. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E
      \u043E\u0442\u0434\u0430\u043B\u0430. \u0410 \u043D\u043E\u0432\u044B\u0435
      \u0431\u0443\u0434\u0443\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u043D\u0435\u0434\u0435\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097121
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097122
    m_Localized: "\u0423\u0432\u044B, \u043D\u0438\u0447\u0435\u043C \u043D\u0435
      \u043C\u043E\u0433\u0443 \u043F\u043E\u043C\u043E\u0447\u044C. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E
      \u0431\u0443\u043C\u0430\u0433\u0443 \u0432\u044B\u0434\u0430\u043B\u0438 \u0441\u0430\u043D\u0438\u0442\u0430\u0440\u0443,
      \u0447\u0442\u043E \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438
      \u0432\u044B\u0448\u0435\u043B. \u041E\u043D \u0438 \u0434\u0440\u043E\u0432\u0430
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0437\u0430\u0431\u0440\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097123
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097124
    m_Localized: "\u0414\u0430 \u043F\u0440\u044F\u043C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0447\u0442\u043E, \u043C\u043E\u0436\u0435\u0442 \u0432\u044B \u0434\u0430\u0436\u0435
      \u0435\u0433\u043E \u0432\u0438\u0434\u0435\u043B\u0438, \u043A\u043E\u0433\u0434\u0430
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097125
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097126
    m_Localized: "\u0412\u0441\u0451, \u043C\u043D\u0435 \u043D\u0435\u043A\u043E\u0433\u0434\u0430
      \u0441 \u0432\u0430\u043C\u0438 \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C,
      \u043D\u0430\u0434\u043E \u043E\u0431\u0445\u043E\u0434 \u0434\u0435\u043B\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097127
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097128
    m_Localized: "\u041D\u043E \u0432\u044B \u0436\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0447\u0442\u043E \u0432\u044B\u0434\u0430\u043B\u0438 \u0434\u0440\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097129
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097130
    m_Localized: "\u0414\u0440\u043E\u0432 \u0431\u044B..."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097131
    m_Localized: "\u041F\u043E\u0441\u0442\u043E\u0439\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097132
    m_Localized: "\u041C\u043E\u0439 \u0434\u043E\u043C \u0431\u0443\u0434\u0443\u0442
      \u0437\u0430\u0441\u0435\u043B\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097133
    m_Localized: "\u041D\u043E \u043C\u043D\u0435 \u043D\u0435\u043B\u044C\u0437\u044F,
      \u0443 \u043C\u0435\u043D\u044F \u0436\u0435\u043D\u0430, \u0440\u0435\u0431\u0435\u043D\u043E\u043A..."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097134
    m_Localized: "\u041E\u043D\u0438... \u0418\u0445 \u043D\u0435\u0442 \u043F\u043E
      \u0431\u0443\u043C\u0430\u0433\u0430\u043C \u0432 \u0434\u043E\u043C\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097135
    m_Localized: "\u042F \u0441\u043B\u044B\u0448\u0430\u043B, \u0447\u0442\u043E
      \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u0431\u0443\u043C\u0430\u0433\u0443, \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u043C
      \u043D\u0435 \u0437\u0430\u0441\u0435\u043B\u044F\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097136
    m_Localized: "\u042F \u0432\u043E\u0437\u0447\u0438\u043A \u0438\u0437 \u0441\u0430\u043D\u0438\u0442\u0430\u0440\u043D\u043E\u0433\u043E
      \u043E\u0442\u0440\u044F\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097137
    m_Localized: "\u042F \u0431\u044B \u0445\u043E\u0442\u0435\u043B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u0442\u0430\u043A\u0443\u044E \u0431\u0443\u043C\u0430\u0433\u0443, \u0447\u0442\u043E\u0431\u044B
      \u0434\u043E\u043C \u043D\u0435 \u0437\u0430\u0441\u0435\u043B\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097138
    m_Localized: "\u041D\u043E \u043C\u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0438
      \u0437\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u0435 \u0447\u0435\u0440\u0435\u0437
      2 \u0434\u043D\u044F \u0431\u0443\u0434\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097139
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0432\u044B\u0448\u0435\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097140
    m_Localized: "\u0414\u0430\u043B\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097141
    m_Localized: "\u0427\u0442\u043E \u044D\u0442\u043E.. \u041A\u0442\u043E \u044D\u0442\u043E...
      \u043D\u0430\u0434\u043E \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0434\u043E\u043C\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097142
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097143
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097144
    m_Localized: "\u041F\u043E\u043C\u043E\u0433\u0438, \u043C\u0443\u0436\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097145
    m_Localized: "\u041C\u0435\u0434\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097146
    m_Localized: "\u041F\u043E\u043C\u043E\u0447\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097147
    m_Localized: "\u0412\u043F\u0435\u0440\u0432\u044B\u0435 \u0432\u0438\u0436\u0443
      \u044D\u0442\u043E\u0433\u043E \u0441\u0430\u043D\u0438\u0442\u0430\u0440\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097148
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097149
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097150
    m_Localized: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097151
    m_Localized: "\u0421\u0430\u043D\u0438\u0442\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097152
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u0438\u0442\u0435, \u044F \u0442\u043E\u0440\u043E\u043F\u043B\u044E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097153
    m_Localized: "\u0421\u0430\u043D\u0438\u0442\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097154
    m_Localized: "\u0427\u0442\u043E \u043C\u043E\u0439 \u0434\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097155
    m_Localized: "\u0421\u0430\u043D\u0438\u0442\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097156
    m_Localized: "\u041D\u0443... \u0414\u043E\u043B\u0436\u043D\u044B... \u041D\u043E
      \u044F \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0431\u0443\u043C\u0430\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097157
    m_Localized: "\u0421\u0430\u043D\u0438\u0442\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097158
    m_Localized: "\u0427\u0442\u043E \u0432\u044B \u043A\u043E \u043C\u043D\u0435
      \u043F\u0440\u0438\u0441\u0442\u0430\u043B\u0438, \u044F \u0442\u043E\u0440\u043E\u043F\u043B\u044E\u0441\u044C,
      \u0434\u043E \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1211097159
    m_Localized: "\u0421\u0430\u043D\u0438\u0442\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097160
    m_Localized: "\u0414\u043E\u0431\u0440\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1211097161
    m_Localized: "\u0423\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291392
    m_Localized: "\u0412\u0430\u0448 \u0434\u043E\u043C..."
    m_Metadata:
      m_Items: []
  - m_Id: 1215291393
    m_Localized: "\u0415\u0433\u043E \u0437\u0430\u0441\u0435\u043B\u044F\u044E\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291394
    m_Localized: "\u041A\u0430\u043A\u0443\u044E \u0431\u0443\u043C\u0430\u0433\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291395
    m_Localized: "\u0427\u0435\u0440\u0442, \u043D\u0430\u0434\u043E \u0435\u0433\u043E
      \u0434\u043E\u0433\u043D\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291396
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291397
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291398
    m_Localized: "\u042F \u043D\u0435 \u043C\u043E\u0433\u0443 \u0443\u0439\u0442\u0438
      \u0438\u0437 \u041D\u043E\u0432\u043E\u043D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\u0430.
      \u0423 \u043C\u0435\u043D\u044F \u0442\u0443\u0442 \u0436\u0435\u043D\u0430,
      \u0440\u0435\u0431\u0435\u043D\u043E\u043A, \u0440\u0430\u0431\u043E\u0442\u0430,
      \u0436\u0438\u0437\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1215291399
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291400
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291401
    m_Localized: "\u041E, \u0441\u043F\u0430\u0441\u0438\u0431\u043E, \u043C\u043E\u0436\u0435\u0442\u0435
      \u043E\u0442\u0434\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291402
    m_Localized: "\u041C\u0435\u0434\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291403
    m_Localized: "\u0423\u0434\u0430\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291404
    m_Localized: "\u0423 \u043C\u0435\u043D\u044F \u043F\u043B\u043E\u0445\u043E\u0435
      \u043F\u0440\u0435\u0434\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291405
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291406
    m_Localized: "\u0412\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291407
    m_Localized: "\u041F\u043E\u043B\u0435\u043D\u043E \u0443\u043A\u0430\u0442\u0438\u043B\u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291408
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291409
    m_Localized: "\u0412\u0437\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291410
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043E\u043D\u0430 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430
      \u0441 \u0441\u0435\u043C\u044C\u0451\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291411
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291412
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291413
    m_Localized: "\u0427\u0430\u0441\u043E\u0432\u043D\u044F \u0437\u0430\u043A\u0440\u044B\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291414
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291415
    m_Localized: "\u042F \u0436\u0435 \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0430\u0441\u043E\u0432\u043D\u044F
      \u0437\u0430\u043A\u0440\u044B\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291416
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291417
    m_Localized: "\u0410 \u0447\u0442\u043E \u0441 \u043D\u0438\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291418
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291419
    m_Localized: "\u041D\u0443 \u0434\u0430, \u0435\u0441\u0442\u044C \u0442\u0430\u043A\u0438\u0435,
      \u0445\u043E\u0437\u044F\u0435\u0432\u0430\u043C \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u0443\u044E
      \u0431\u0443\u043C\u0430\u0433\u0443 \u0432\u044B\u0434\u0430\u044E\u0442 \u0438
      \u0432 \u0434\u043E\u043C \u043D\u0435 \u0437\u0430\u0441\u0435\u043B\u044F\u044E\u0442
      \u043D\u0438\u043A\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1215291420
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291421
    m_Localized: "\u041D\u0435 \u0437\u043D\u0430\u044E, \u0432\u0440\u043E\u0434\u0435
      \u043D\u0430\u0434\u043E \u0431\u044B\u0442\u044C \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u043E\u043C
      \u0438\u043B\u0438 \u0441\u0430\u043D\u0438\u0442\u0430\u0440\u043E\u043C,
      \u0438\u043B\u0438 \u0435\u0449\u0435 \u043A\u0435\u043C-\u0442\u043E \u0438\u0437
      \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1215291422
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291423
    m_Localized: "\u042D\u0442\u043E \u0432\u044B \u0442\u0440\u0443\u043F\u044B
      \u0432\u043E\u0437\u0438\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291424
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291425
    m_Localized: "\u041D\u0435\u043B\u0435\u0433\u043A\u043E, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
      \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u043C\u0435\u0440\u0442\u0432\u044B\u0445
      \u0432\u0438\u0434\u0435\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291426
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291427
    m_Localized: "\"\u043C\u043E\u043B\u0447\u0438\u0442\""
    m_Metadata:
      m_Items: []
  - m_Id: 1215291428
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291429
    m_Localized: "\u0415\u0441\u043B\u0438 \u0442\u044B \u0438\u0437 \u0441\u0430\u043D\u0438\u0442\u0430\u0440\u043E\u0432,
      \u0442\u043E \u0441\u0445\u043E\u0434\u0438 \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0443,
      \u043C\u043E\u0436\u0435\u0442 \u0442\u0435\u0431\u0435 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0430
      \u0442\u0430\u043A\u0430\u044F \u0431\u0443\u043C\u0430\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1215291430
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291431
    m_Localized: "\u042F \u0445\u043E\u0442\u0435\u043B \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291432
    m_Localized: "\u042F \u043D\u0435 \u043E\u0431 \u044D\u0442\u043E\u043C, \u044F
      \u043E \u0434\u043E\u043C\u0430\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0437\u0430\u0441\u0435\u043B\u044F\u044E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291433
    m_Localized: "\u0421\u043B\u044B\u0448\u0430\u043B, \u0447\u0442\u043E \u043A\u0430\u043A\u0438\u0435-\u0442\u043E
      \u043D\u0435 \u0437\u0430\u0441\u0435\u043B\u044F\u044E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291434
    m_Localized: "\u0410 \u043A\u0430\u043A \u0435\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291435
    m_Localized: "\u042F \u0440\u0430\u0431\u043E\u0442\u0430\u044E \u0432\u043E\u0437\u0447\u0438\u043A\u043E\u043C
      \u0432 \u0441\u0430\u043D\u0438\u0442\u0430\u0440\u043D\u043E\u043C \u043E\u0442\u0440\u044F\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1215291436
    m_Localized: "\u0414\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 1215291437
    m_Localized: "\u041F\u043E-\u0440\u0430\u0437\u043D\u043E\u043C\u0443... \u0418\u043D\u043E\u0433\u0434\u0430,
      \u043B\u0443\u0447\u0448\u0435 \u0432\u0438\u0434\u0435\u0442\u044C \u043C\u0435\u0440\u0442\u0432\u044B\u0445,
      \u0447\u0435\u043C \u0436\u0438\u0432\u044B\u0445, \u043A\u043E\u0442\u043E\u044B\u0440\u0435
      \u0443\u0436\u0435 \u043F\u043E\u0447\u0442\u0438 \u043D\u0435\u0436\u0438\u0432\u044B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291438
    m_Localized: "\u0414\u0430\u043B\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291439
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291440
    m_Localized: "\u0423\u043C\u0435\u0440 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439 \u043D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291441
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291442
    m_Localized: "\u0411\u044B\u043B\u0430 \u043D\u043E\u0447\u044C, \u043D\u0430
      \u0443\u0442\u0440\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0432\u0438\u0434\u0435\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291443
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291444
    m_Localized: "\u041D\u0430 \u0443\u0442\u0440\u043E \u0443\u0436\u0435 \u043F\u0440\u0438\u043C\u0435\u0440\u0437..."
    m_Metadata:
      m_Items: []
  - m_Id: 1215291445
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291446
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0436\u0434\u0430\u0442\u044C \u043E\u0442\u0442\u0435\u043F\u0435\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291447
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291448
    m_Localized: "\u0414\u0430\u043B\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291449
    m_Localized: "\u0414\u0430\u043B\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291450
    m_Localized: "\u0414\u0430\u043B\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291451
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291452
    m_Localized: "\u0427\u0442\u043E \u044D\u0442\u043E \u0431\u044B\u043B\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291453
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291454
    m_Localized: "\u041E\u043D\u0438 \u0431\u044B\u043B\u0438 \u0436\u0438\u0432\u044B\u0435?..."
    m_Metadata:
      m_Items: []
  - m_Id: 1215291455
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291456
    m_Localized: "\u042F \u043D\u0435 \u0437\u043D\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291457
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0442\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 1215291458
    m_Localized: "\"\u0447\u0442\u043E-\u0442\u043E \u0431\u0435\u0441\u0441\u0432\u044F\u0437\u043D\u043E
      \u0431\u043E\u0440\u043C\u043E\u0447\u0435\u0442\""
    m_Metadata:
      m_Items: []
  - m_Id: 1215291459
    m_Localized: "\u0421\u0430\u043D\u0438\u0442\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291460
    m_Localized: "\u0423\u0434\u0430\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291461
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435\u043C
      \u043D\u0435 \u043C\u043E\u0433\u0443 \u043F\u043E\u043C\u043E\u0447\u044C..."
    m_Metadata:
      m_Items: []
  - m_Id: 1215291462
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291463
    m_Localized: "\u0423\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1215291464
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 1215291465
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
