  - m_Id: 353901923524608
    m_Localized: "\u0420\u041E\u0421\u0421\u0418\u0419\u0421\u041A\u0410\u042F \u0421\u041E\u0426\u0418\u0410\u041B\u0418\u0421\u0422\u0418\u0427\u0415\u0421\u041A\u0410\u042F
      \u0424\u0415\u0414\u0415\u0420\u0410\u0422\u0418\u0412\u041D\u0410\u042F \u0421\u041E\u0412\u0415\u0422\u0421\u041A\u0410\u042F
      \u0420\u0415\u0421\u041F\u0423\u0411\u041B\u0418\u041A\u0410\n\n\u041D\u041E\u0412\u041E\u041D\u0418\u041A\u041E\u041B\u0410\u0415\u0412\u0421\u041A\u0410\u042F
      \u0413\u0423\u0411\u0415\u0420\u041D\u0421\u041A\u0410\u042F \u0427\u0420\u0415\u0417\u0412\u042B\u0427\u0410\u0419\u041D\u0410\u042F
      \u041A\u0412\u0410\u0420\u0422\u0418\u0420\u041D\u0410\u042F \u041A\u041E\u041C\u0418\u0421\u0421\u0418\u042F\n\n\u041F\u0420\u0415\u0414\u041F\u0418\u0421\u0410\u041D\u0418\u0415
      \u2116 47\n\n\u0433. \u041D\u043E\u0432\u043E-\u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0441\u043A\n\n12
      \u044F\u043D\u0432\u0430\u0440\u044F 1920 \u0433\u043E\u0434\u0430\n\n\u0412\u0432\u0438\u0434\u0443
      \u0447\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u043E\u0433\u043E
      \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F, \u0432\u044B\u0437\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435\u043C
      \u044D\u043F\u0438\u0434\u0435\u043C\u0438\u0438 \u0441\u044B\u043F\u043D\u043E\u0433\u043E
      \u0442\u0438\u0444\u0430, \u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F \u0431\u0435\u0441\u043F\u0435\u0440\u0435\u0431\u043E\u0439\u043D\u043E\u0439
      \u0440\u0430\u0431\u043E\u0442\u044B \u0441\u0430\u043D\u0438\u0442\u0430\u0440\u043D\u044B\u0445
      \u0438 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u0445 \u0441\u043B\u0443\u0436\u0430\u0449\u0438\u0445,\n\n\u041F\u0420\u0415\u0414\u041F\u0418\u0421\u042B\u0412\u0410\u0415\u0422\u0421\u042F:\n\n\u0416\u0438\u043B\u043E\u0435
      \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0435, \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u043C\u043E\u0435
      \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0442\u0435\u043B\u0435\u043C
      \u0441\u0435\u0433\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430,
      \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u044C \u043E\u0442 \u043F\u0440\u0438\u043D\u0443\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u0443\u043F\u043B\u043E\u0442\u043D\u0435\u043D\u0438\u044F, \u0440\u0435\u043A\u0432\u0438\u0437\u0438\u0446\u0438\u0438
      \u0438 \u0432\u0441\u0435\u043B\u0435\u043D\u0438\u044F \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0445
      \u043B\u0438\u0446.\n\n\u0412\u0441\u0435\u043C \u0434\u043E\u043C\u043E\u0432\u044B\u043C
      \u043A\u043E\u043C\u0438\u0442\u0435\u0442\u0430\u043C, \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u043D\u044B\u043C
      \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u044F\u043C \u0438 \u0443\u043F\u043E\u043B\u043D\u043E\u043C\u043E\u0447\u0435\u043D\u043D\u044B\u043C
      \u043F\u043E \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u044E \u0433\u0440\u0430\u0436\u0434\u0430\u043D
      \u043F\u0440\u0435\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0435 \u0447\u0438\u043D\u0438\u0442\u044C \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u0439
      \u0432 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u043E\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044B\u043C
      \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0435\u043C.\n\n\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
      \u043F\u0440\u0435\u0434\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442
      \u0441\u0438\u043B\u0443 \u0432\u043F\u0440\u0435\u0434\u044C \u0434\u043E
      \u043E\u0441\u043E\u0431\u043E\u0433\u043E \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u044F
      \u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u043E\u0439 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u043D\u043E\u0439
      \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u0438.\n\n\u0423\u043F\u043E\u043B\u043D\u043E\u043C\u043E\u0447\u0435\u043D\u043D\u044B\u0439
      \u0433\u0443\u0431\u0435\u0440\u043D\u0441\u043A\u043E\u0439 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u043D\u043E\u0439
      \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u0438\n\n\u0418. \u041D. \u0417\u0430\u0432\u044C\u044F\u043B\u043E\u0432\n\n\u041F\u043E\u0434\u043F\u0438\u0441\u044C
      ____________\n\n\u041C. \u041F."
    m_Metadata:
      m_Items: []
