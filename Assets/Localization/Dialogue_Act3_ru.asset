    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723103
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u0438\u0437 \u0434\u043E\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723104
    m_Localized: "\u0421\u044B\u043D... \u041E\u043D \u0441 \u0442\u043E\u0431\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723105
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723106
    m_Localized: "\u0410 \u0441 \u043A\u0435\u043C \u0435\u043C\u0443 \u0435\u0449\u0435
      \u0431\u044B\u0442\u044C? \u041A\u0430\u043A \u0443\u0441\u043F\u0435\u0445\u0438
      \u0441 \u0431\u0443\u043C\u0430\u0433\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723107
    m_Localized: "\u0416\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723108
    m_Localized: "\u041D\u0430\u043C \u043D\u0435 \u0433\u0440\u043E\u0437\u0438\u0442
      \u0437\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723109
    m_Localized: "\u0416\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723110
    m_Localized: "\u0414\u0430\u043B\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723111
    m_Localized: "\u042F \u0434\u043E\u0441\u0442\u0430\u043B \u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723112
    m_Localized: "\u041D\u0435\u0442, \u0442\u0435\u043F\u0435\u0440\u044C..."
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723113
    m_Localized: "\u041C\u043E\u0439 \u0441\u044B\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723114
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723115
    m_Localized: "\u041E\u0442\u043E\u0439\u0434\u0438 \u043E\u0442 \u043A\u0440\u043E\u0432\u0430\u0442\u043A\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723116
    m_Localized: "\u0412 \u0415\u043B\u0430\u043D\u043A\u0443 \u0442\u043E\u0433\u0434\u0430
      \u043F\u0440\u0438\u0435\u0437\u0436\u0430\u043B \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444.
      \u041C\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438 \u0441\u0435\u043C\u0443\u0439\u043D\u0443\u044E
      \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723117
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723118
    m_Localized: "\u0412 \u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442
      \u043C\u044B \u0431\u044B\u043B\u0438 \u0435\u0449\u0435 \u0432\u043C\u0435\u0441\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723119
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723120
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0442\u0443\u0442 \u0432\u0441\u0435 \u0432\u043C\u0435\u0441\u0442\u0435.
      \u041D\u0430 \u0441\u0442\u0435\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723121
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723122
    m_Localized: "\u0414\u0430\u043B\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723123
    m_Localized: "\u0414\u0430\u043B\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 4707479022723124
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 4711410436136960
    m_Localized: "\u0422\u041E\u041C\u0421\u041A\u0410\u042F \u0413\u0423\u0411\u0415\u0420\u041D\u0421\u041A\u0410\u042F\n\u0427\u0420\u0415\u0417\u0412\u042B\u0427\u0410\u0419\u041D\u0410\u042F
      \u041A\u041E\u041C\u0418\u0421\u0421\u0418\u042F\n\u041F\u041E \u0411\u041E\u0420\u042C\u0411\u0415
      \u0421 \u0422\u0418\u0424\u041E\u041C\n\u041F\u0420\u0415\u0414\u041F\u0418\u0421\u0410\u041D\u0418\u0415\n8
      \u044F\u043D\u0432\u0430\u0440\u044F 1920 \u0433.\n\u2116 47\n"
    m_Metadata:
      m_Items: []
  - m_Id: 4711410436136961
    m_Localized: "\u0423\u043F\u043E\u043B\u043D\u043E\u043C\u043E\u0447\u0435\u043D\u043D\u044B\u0439
      \u0427\u0435\u043A\u0430\u0442\u0438\u0444\u0430\n\u0410. \u041F. \u0412\u0435\u0434\u0435\u043D\u0435\u0435\u0432\n\u043F\u043E\u0434\u043F\u0438\u0441\u044C\n\u041C.
      \u041F.t"
    m_Metadata:
      m_Items: []
  - m_Id: 4711410436136962
    m_Localized: "\u0414\u043E\u043C\u043E\u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0443
      \u0441\u0435\u0433\u043E \u0434\u043E\u043C\u0430\n\u041F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0451\u043D\u043D\u044B\u043C
      \u043E\u0441\u043C\u043E\u0442\u0440\u043E\u043C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E,
      \u0447\u0442\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0436\u0438\u043B\u043E\u0435
      \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u0437\u0430\u043D\u044F\u0442\u043E
      \u043E\u0434\u043D\u0438\u043C \u043B\u0438\u0446\u043E\u043C \u0438 \u0438\u043C\u0435\u0435\u0442
      \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0443\u044E \u0436\u0438\u043B\u0443\u044E
      \u043F\u043B\u043E\u0449\u0430\u0434\u044C.\n\u041D\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0438
      \u043F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \u0427\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u043E\u0439 \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u0438
      \u043F\u043E \u0431\u043E\u0440\u044C\u0431\u0435 \u0441 \u0442\u0438\u0444\u043E\u043C
      \u043F\u0440\u0435\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435
      \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u0434\u043B\u044F \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u044F
      \u0433\u0440\u0430\u0436\u0434\u0430\u043D, \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u043C\u044B\u0445
      \u041A\u043E\u043C\u0438\u0441\u0441\u0438\u0435\u0439.\n\u041F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0435
      \u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
      \u043A \u0437\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044E \u043D\u0435
      \u043F\u043E\u0437\u0434\u043D\u0435\u0435 10 \u044F\u043D\u0432\u0430\u0440\u044F
      \u0441\u0435\u0433\u043E \u0433\u043E\u0434\u0430.\n\u041E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
      \u0437\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F \u0431\u0443\u0434\u0435\u0442
      \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u043E \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E.\n\u041D\u0435\u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E \u043F\u0440\u0435\u0434\u043F\u0438\u0441\u0430\u043D\u0438\u044F
