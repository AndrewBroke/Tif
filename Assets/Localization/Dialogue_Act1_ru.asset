  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_Act1_ru
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ru
  m_SharedData: {fileID: 11400000, guid: 53d9c73058c85104485c8bc0ca67d485, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1651499016
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u043B\u0441\u044F, \u043A\u0430\u043A
      \u0440\u0430\u0431\u043E\u0442\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499017
    m_Localized: "\u0416\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499018
    m_Localized: "\u0422\u0443\u0442 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u0438
      \u0441\u043E\u043B\u0434\u0430\u0442\u044B..."
    m_Metadata:
      m_Items: []
  - m_Id: 1651499019
    m_Localized: "\u0416\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499020
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u0434\u043E\u043C.
      \u042F \u0438\u0445 \u0434\u0430\u043B\u044C\u0448\u0435 \u043F\u043E\u0440\u043E\u0433\u0430
      \u043D\u0435 \u043F\u0443\u0441\u0442\u0438\u043B\u0430, \u0441\u043A\u0430\u0437\u0430\u043B\u0430,
      \u0447\u0442\u043E \u0443 \u043D\u0430\u0441 \u0440\u0435\u0431\u0435\u043D\u043E\u043A
      \u0438 \u043D\u0435 \u0445\u043E\u0447\u0443, \u0447\u0442\u043E\u0431\u044B
      \u043E\u043D\u0438 \u0437\u0430\u043D\u0435\u0441\u043B\u0438 \u0437\u0430\u0440\u0430\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1651499021
    m_Localized: "\u0416\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499022
    m_Localized: "\u0414\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 1651499023
    m_Localized: "\u0416\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499024
    m_Localized: "\u0421\u043A\u0430\u0437\u0430\u043B\u0438, \u0447\u0442\u043E
      \u0442\u0443\u0442 \u043F\u043E \u0431\u0443\u043C\u0430\u0433\u0430\u043C
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u044B \u0436\u0438\u0432\u0435\u0448\u044C,
      \u043D\u0438\u043A\u0430\u043A\u0438\u0445 \u0436\u0435\u043D\u0449\u0438\u043D
      \u0438 \u0434\u0435\u0442\u0435\u0439 \u0431\u044B\u0442\u044C \u043D\u0435
      \u0434\u043E\u043B\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1651499025
    m_Localized: "\u0416\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499026
    m_Localized: "\u0414\u0430\u043B\u0438 \u043A\u0430\u043A\u043E\u0435-\u0442\u043E
      \u043F\u0440\u0435\u0434\u043F\u0438\u0441\u0430\u043D\u0438\u0435, \u044F
      \u0435\u0433\u043E \u043D\u0430 \u0441\u0442\u043E\u043B \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0430.
      \u0418 \u0441\u043A\u0430\u0437\u0430\u043B\u0438 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0438
      \u0434\u0432\u0443\u0445 \u0434\u043D\u0435\u0439 \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u044C
      \u0434\u043E\u043C \u0434\u043B\u044F \u0437\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1651499027
    m_Localized: "\u0416\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499028
    m_Localized: "\u041F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F, \u043E\u043F\u044F\u0442\u044C.
      \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
      \u043E\u0447\u0435\u043D\u044C \u043F\u043B\u043E\u0445\u043E \u0441\u043F\u0438\u0442.
      \u0410 \u043F\u043E\u0441\u043B\u0435 \u0441\u043E\u043B\u0434\u0430\u0442
      \u043E\u0447\u0435\u043D\u044C \u0434\u043E\u043B\u0433\u043E \u0441\u043F\u0430\u0442\u044C
      \u043D\u0435 \u0445\u043E\u0442\u0435\u043B. \u041F\u043E\u0439\u0434\u0443
      \u0443\u0441\u043F\u043E\u043A\u043E\u044E. \u0410 \u0442\u044B \u0433\u043B\u044F\u043D\u044C
      \u044D\u0442\u0443 \u0431\u0443\u043C\u0430\u0433\u0443 \u0438 \u043F\u0435\u0447\u043A\u0443
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438, \u0442\u0430\u043C \u0443\u0436\u0435,
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0434\u043E\u0433\u043E\u0440\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1651499029
    m_Localized: "\u0416\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499030
    m_Localized: "\u041C\u043D\u043E\u0433\u043E \u043C\u0435\u0440\u0442\u0432\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499031
    m_Localized: "\u041A\u0430\u043A \u043E\u0431\u044B\u0447\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499032
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499033
    m_Localized: "\u0417\u0430\u0447\u0435\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499034
    m_Localized: "\u041E\u043D\u0438 \u0445\u043E\u0442\u044F\u0442 \u0437\u0430\u0441\u0435\u043B\u0438\u0442\u044C
      \u0434\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499035
    m_Localized: "\u0414\u0430\u043B\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499036
    m_Localized: "\u0414\u0430\u043B\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499037
    m_Localized: "\u041D\u0430\u0434\u043E \u0447\u0442\u043E-\u043D\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 1668276224
    m_Localized: "\u0414\u0430\u043B\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1668276225
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499066
    m_Localized: "\u0427\u0442\u043E \u043D\u0430\u043C \u0434\u0435\u043B\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499067
    m_Localized: "\u0416\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499068
    m_Localized: "\u041C\u043E\u0436\u0435\u0442 \u043D\u0430\u043C \u0443\u0435\u0445\u0430\u0442\u044C?
      \u042F \u0441\u043B\u044B\u0448\u0430\u043B\u0430, \u0447\u0442\u043E \u043F\u043E\u0435\u0437\u0434\u0430
      \u043A\u0430\u043A\u0438\u0435-\u0442\u043E \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1651499069
    m_Localized: "\u0416\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499070
    m_Localized: "\u0425\u043E\u0442\u044F \u0441\u043E\u0441\u0435\u0434\u043A\u0430
      \u0441\u043A\u0430\u0437\u0430\u043B\u0430, \u0447\u0442\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0431\u0443\u0434\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0432
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u043C\u0435\u0441\u044F\u0446\u0435
      \u0438\u0437-\u0437\u0430 \u0445\u043E\u043B\u043E\u0434\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1651499071
    m_Localized: "\u0416\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499072
    m_Localized: "\u0415\u0449\u0435 \u043E\u043D\u0430 \u0441\u043A\u0430\u0437\u0430\u043B\u0430,
      \u0447\u0442\u043E \u0443 \u0432\u0441\u044F\u043A\u0438\u0445 \u0432\u0440\u0430\u0447\u0435\u0439
      \u0438 \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u043E\u0432 \u0434\u043E\u043C\u0430
      \u043D\u0435 \u0437\u0430\u0431\u0438\u0440\u0430\u044E\u0442. \u041C\u043E\u043B
      \u0443 \u043D\u0438\u0445 \u0442\u0430\u043C \u043A\u0430\u043A\u0430\u044F-\u0442\u043E
      \u0431\u0443\u043C\u0430\u0433\u0430 \u0435\u0441\u0442\u044C, \u0441 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043D\u0435 \u0438\u043C\u0435\u044E\u0442 \u043F\u0440\u0430\u0432\u043E
      \u0437\u0430\u0441\u0435\u043B\u0438\u0442\u044C \u043D\u0438\u043A\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1651499073
    m_Localized: "\u0416\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499074
    m_Localized: "\u0422\u044B \u0436\u0435 \u0441\u0435\u0439\u0447\u0430\u0441
      \u0437\u0430 \u0434\u0440\u043E\u0432\u0430\u043C\u0438? \u042F \u0432\u0438\u0434\u0435\u043B\u0430
      \u0441\u043E\u043B\u0434\u0430\u0442\u0430 \u0443 \u0447\u0430\u0441\u043E\u0432\u043D\u0438.
      \u041C\u043E\u0436\u0435\u0442 \u043E\u043D \u0437\u043D\u0430\u0435\u0442,
      \u043A\u0430\u043A\u0438\u0435 \u0434\u043E\u043C\u0430 \u0437\u0430\u0431\u0438\u0440\u0430\u044E\u0442,
      \u0430 \u043A\u0430\u043A\u0438\u0435 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1651499075
    m_Localized: "\u0416\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499076
    m_Localized: "\u042F... \u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u043E\u044E\u0441\u044C
      \u0437\u0430 \u0441\u044B\u043D\u0430... \u0415\u0441\u043B\u0438 \u043D\u0430\u0441
      \u0432\u044B\u0433\u043E\u043D\u044F\u0442..."
    m_Metadata:
      m_Items: []
  - m_Id: 1651499077
    m_Localized: "\u0416\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499078
    m_Localized: "\u042F \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499079
    m_Localized: "\u041D\u0435 \u0432\u044B\u0433\u043E\u043D\u044F\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499080
    m_Localized: "\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C..."
    m_Metadata:
      m_Items: []
  - m_Id: 1651499081
    m_Localized: "\u0414\u0430\u043B\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499082
    m_Localized: "\u041C\u043E\u0436\u0435\u0442 \u0434\u043E\u0441\u0442\u0430\u0442\u044C
      \u044D\u0442\u0443 \u0431\u0443\u043C\u0430\u0433\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499083
    m_Localized: "\u0414\u0430\u043B\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1500504064
    m_Localized: "\u042D\u0442\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1643110400
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1643110401
    m_Localized: "\u0412\u0437\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499059
    m_Localized: "\u042F \u043E\u0447\u0435\u043D\u044C \u0433\u043E\u043B\u043E\u0434\u0435\u043D,
      \u043D\u0430\u0434\u0435\u044E\u0441\u044C, \u044D\u0442\u043E \u043D\u0435
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043A\u0443\u0441\u043E\u043A.
      \u0417\u0430\u0440\u043F\u043B\u0430\u0442\u0430 \u0435\u0449\u0435 \u043D\u0435
      \u0441\u043A\u043E\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499060
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499061
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499062
    m_Localized: "\u0421\u044A\u0435\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499053
    m_Localized: "\u041F\u0440\u0435\u0434\u043F\u0438\u0441\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499054
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499055
    m_Localized: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499056
    m_Localized: "\u041D\u0430\u0434\u043E \u0443\u0441\u043F\u0435\u0442\u044C \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F,
      \u043F\u043E\u043A\u0430 \u043E\u0433\u043E\u043D\u044C \u043D\u0435 \u043F\u043E\u0433\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 1651499057
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499058
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u0438\u0437 \u0434\u043E\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499063
    m_Localized: "\u0423\u0436\u0435 \u0434\u043E\u0433\u043E\u0440\u0430\u0435\u0442,
      \u043D\u0430\u0434\u043E \u043F\u043E\u0434\u043A\u0438\u043D\u0443\u0442\u044C
      \u0447\u0435\u0433\u043E-\u043D\u0438\u0431\u0443\u0434\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1651499064
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499065
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499038
    m_Localized: "\"\u041E\u0433\u043E\u043D\u044C \u0441\u0442\u0430\u043B \u0435\u0449\u0435
      \u0442\u0443\u0441\u043A\u043D\u0435\u0435\""
    m_Metadata:
      m_Items: []
  - m_Id: 1651499039
    m_Localized: "\u041F\u0435\u0447\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499040
    m_Localized: "\"\u041E\u0433\u043E\u043D\u044C \u0441\u0442\u0430\u043B \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u044F\u0440\u0447\u0435\""
    m_Metadata:
      m_Items: []
  - m_Id: 1651499041
    m_Localized: "\u041F\u0435\u0447\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499042
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u0435\u0449\u0435
      \u0434\u0440\u043E\u0432\u0430, \u043F\u043E\u043A\u0430 \u043D\u0435 \u0441\u0442\u0435\u043C\u043D\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1651499043
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499044
    m_Localized: "\u0412 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0435 \u0434\u043E\u0436\u043D\u044B
      \u0435\u0449\u0435 \u0432\u044B\u0434\u0430\u0432\u0430\u0442\u044C, \u0435\u0441\u043B\u0438
      \u0443\u0441\u043F\u0435\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 1651499045
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1651499046
    m_Localized: "\u041D\u0435 \u0445\u043E\u0447\u0443 \u043E\u043F\u044F\u0442\u044C
